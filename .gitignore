__pycache__/
*.pyc
*.pyo
*.pyd
.venv
venv
*.egg-info/
dist/
build/
*.egg

# Secrets & credentials
.env
.env.*
!.env.example
*.key
*.pem
*.p12
credentials.json
token.json
secrets/

# Personal monitor config (NBG-specific brand keywords + RSS feeds).
# Tracked .example.yaml templates show forkers the structure to follow.
config/monitor/sources.yaml
config/monitor/keywords.yaml
# ...and every backup of them, which carries the same private content. The exact
# names above walk straight past `sources.yaml.bak-<date>`: five such copies once
# sat untracked and un-ignored in a checkout, one `git add -A` from publication.
config/monitor/*.bak*

# Personal launchd plists (per-machine deployment artifacts).
# Tracked .example.plist templates show forkers the schema.
launchd/com.news.digest.plist
launchd/com.news.monitor.plist

