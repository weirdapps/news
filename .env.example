# News reader — environment variable template.
# Copy this file to .env and fill in real values.
# .env is gitignored; .env.example is committed as documentation.

# Email recipient for the digest pipeline (5x daily).
NEWS_RECIPIENT=you@example.com

# Email recipient for the monitor pipeline (bi-hourly brand monitoring).
# Usually the same as NEWS_RECIPIENT.
NEWS_MONITOR_RECIPIENT=you@example.com
